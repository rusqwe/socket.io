{
  "name": "socketio-chat",
  "version": "2.0.0",
  "description": "Chat with two rooms using Socket.IO",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build:server": "tsc",
    "build:client": "tsc --project tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "tsc --project tsconfig.client.json --watch",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "express": "^4.18.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0"
  }
}
